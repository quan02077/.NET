<Window x:Class="KT2.Views.Bai1View"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:KT2.ViewModels"
        xmlns:local="clr-namespace:KT2.Views"
        mc:Ignorable="d"
        Title="Bai1View" Height="450" Width="800">
    <Window.DataContext>
        <vm:Bai1VM/>
    </Window.DataContext>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <GroupBox Header="Thông tin phòng" Grid.Row="0" Padding="10" FontWeight="Bold" FontSize="14" BorderBrush="#828790">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="50"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Label Content="Chọn tầng nhà:" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"/>
                <ComboBox x:Name="cmbTang" Grid.Row="0" Grid.Column="1" Height="30" VerticalContentAlignment="Center" 
                  ItemsSource="{Binding ds_Tang}" 
                  DisplayMemberPath="TenNhom" 
                  SelectedValuePath="MaNhom"
                  SelectedValue="{Binding SelectedMaNhom, UpdateSourceTrigger=PropertyChanged}"/>

                <Label Content="Mã phòng:" Grid.Row="0" Grid.Column="3" VerticalAlignment="Center"/>
                <TextBox Text="{Binding MaPhong, UpdateSourceTrigger=PropertyChanged}" Grid.Row="0" Grid.Column="4" Height="30" VerticalContentAlignment="Center"/>

                <Label Content="Tên phòng:" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center"/>
                <TextBox Text="{Binding TenPhong, UpdateSourceTrigger=PropertyChanged}" Grid.Row="1" Grid.Column="1" Height="30" VerticalContentAlignment="Center"/>

                <Label Content="Giá phòng:" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center"/>
                <TextBox Text="{Binding GiaPhong, UpdateSourceTrigger=PropertyChanged}" Grid.Row="2" Grid.Column="1" Height="30" VerticalContentAlignment="Center"/>

                <GroupBox Header="Loại phòng" Grid.Row="1" Grid.Column="3" Grid.ColumnSpan="2" Grid.RowSpan="3" Margin="0,5,0,0">
                    <StackPanel Margin="10,5">
                        <RadioButton x:Name="rbPhongQuat" Content="Phòng quạt" Margin="0,5" FontWeight="Normal" 
                             IsChecked="{Binding IsPhongQuat, Mode=TwoWay}"/>
                        <RadioButton x:Name="rbPhongMayLanh" Content="Phòng máy lạnh" Margin="0,5" FontWeight="Normal" 
                             IsChecked="{Binding IsPhongMayLanh, Mode=TwoWay}"/>
                    </StackPanel>
                </GroupBox>

                <Label Content="Sức chứa tối đa:" Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" Margin="0,10,0,0"/>
                <TextBox Text="{Binding SucChua, UpdateSourceTrigger=PropertyChanged}" Grid.Row="3" Grid.Column="1" Height="30" VerticalContentAlignment="Center" Margin="0,10,0,0"/>
            </Grid>
        </GroupBox>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20">
            <Button x:Name="btnThem" Content="Thêm" Width="100" Height="40" Margin="10,0" Background="#e1e1e1" Command="{Binding AddCommand}"/>
            <Button x:Name="btnXoa" Content="Xóa" Width="100" Height="40" Margin="10,0" Background="#e1e1e1" Command="{Binding ClearCommand}"/>
            <Button x:Name="btnSua" Content="Sửa" Width="100" Height="40" Margin="10,0" Background="#e1e1e1" Command="{Binding EditCommand}"/>
            <Button x:Name="btnLuu" Content="Lưu" Width="100" Height="40" Margin="10,0" Background="#e1e1e1" Command="{Binding SaveCommand}"/>
        </StackPanel>

        <DataGrid x:Name="dgPhong" Grid.Row="2" AutoGenerateColumns="False" 
                  CanUserAddRows="False" Background="White" BorderBrush="#828790"
                  HeadersVisibility="Column" GridLinesVisibility="All"
                  ItemsSource="{Binding ds_Phong}"
                  SelectedItem="{Binding SelectedPhong, Mode=TwoWay}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Mã phòng" Binding="{Binding MaPhong}" Width="100"/>
                <DataGridTextColumn Header="Tên phòng" Binding="{Binding TenPhong}" Width="150"/>
                <DataGridTextColumn Header="Sức chứa" Binding="{Binding SucChua}" Width="100"/>
                <DataGridTextColumn Header="Giá phòng" Binding="{Binding GiaPhong}" Width="120"/>
                <DataGridTextColumn Header="Tên tầng" Binding="{Binding LOAIPHONG.TenNhom}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
