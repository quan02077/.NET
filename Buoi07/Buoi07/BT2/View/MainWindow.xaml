<Window x:Class="Buoi07.BT2.View.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Buoi07.BT2.View"
        xmlns:vm="clr-namespace:Buoi07.BT2.ViewModel"
        mc:Ignorable="d"
        Title="MainWindow" Height="350" Width="850">
    <Window.DataContext>
        <vm:MainVM/>
    </Window.DataContext>
    <Grid Margin="0,10,0,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Label Content="KHÁCH SẢN THANH THANH - TRẢ PHÒNG" Grid.ColumnSpan="2" HorizontalAlignment="Center" FontSize="30" FontWeight="bold" Foreground="Orange"/>
        <Border BorderBrush="Black" BorderThickness="1" Grid.Row="1" Padding="30,10,30,10">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Họ và tên: " Width="100"/>
                    <TextBox Width="200" Grid.Column="1" Margin="0,0,0,10" HorizontalAlignment="Left" Text="{Binding NewName}"/>
                    <TextBlock Text="Địa chỉ: " Width="100" Grid.Row="1"/>
                    <TextBox Width="300" Grid.Column="1" Grid.Row="1" Margin="0,0,0,10" Text="{Binding NewAddress}"/>
                    <TextBlock Text="Số ngày ở: " Width="100" Grid.Row="2"/>
                    <TextBox Width="50" Grid.Column="1" Grid.Row="2" Margin="0,0,0,10" HorizontalAlignment="Left" Text="{Binding DayStay}"/>
                </Grid>
                <StackPanel Orientation="Horizontal">
                    <GroupBox Header="Loại phòng" Margin="5">
                        <StackPanel Margin="10">
                            <RadioButton Content="Phòng đơn" IsChecked="{Binding IsPhongDon}"/>
                            <RadioButton Content="Phòng đôi" IsChecked="{Binding IsPhongDoi}"/>
                            <RadioButton Content="Phòng ba" IsChecked="{Binding IsPhongBa}"/>
                        </StackPanel>
                    </GroupBox>
                    <GroupBox Header="Tiện nghi" Margin="5">
                        <StackPanel Margin="10">
                            <CheckBox Content="Tivi" IsChecked="{Binding HasTivi}"/>
                            <CheckBox Content="Internet" IsChecked="{Binding HasInternet}"/>
                            <CheckBox Content="Máy nước nóng" IsChecked="{Binding HasMayNuocNong}"/>
                        </StackPanel>
                    </GroupBox>
                    <GroupBox Header="Dịch vụ" Margin="5">
                        <StackPanel Margin="10">
                            <CheckBox Content="Karaoke" IsChecked="{Binding HasKaraoke}"/>
                            <CheckBox Content="Ăn sáng" IsChecked="{Binding HasAnSang}"/>
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </StackPanel>
        </Border>
        <Border BorderBrush="Black" BorderThickness="1" Grid.Row="1" Grid.Column="1" Padding="30,10,30,10">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <Button Content="_Thanh Toán" Height="30" Margin="0,0,10,0" Width="90" Command="{Binding ThanhToanCommand}"/>
                    <Button Content="_Nhập mới" Height="30" Width="90" Command="{Binding NhapMoiCommand}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="Thành tiền:" Width="100"/>
                    <TextBox Text="{Binding ThanhTien, StringFormat='{}{0:N0} VNĐ'}" IsReadOnly="True"/>
                </StackPanel>
                <Button Content="Tổng kết" Command="{Binding TongKetCommand}"/>
                <GroupBox Header="Thông tin tổng kết">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="Số lượt người:" Width="80"/>
                            <TextBox Width="176" Text="{Binding TongSoLuotNguoi}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="Tổng số tiền:" Width="80"/>
                            <TextBox Width="176" Text="{Binding TongDoanhThu}"/>
                        </StackPanel>
                    </StackPanel>
                </GroupBox>
                <Button Content="Thoát" Command="{Binding ThoatCommand}"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
