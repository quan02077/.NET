<UserControl x:Class="Buoi07.BT3.View.UCThongTinKhachHang"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="White" Height="388" Width="739">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="THÔNG TIN KHÁCH HÀNG" FontSize="24" FontWeight="Bold" Foreground="DarkBlue" HorizontalAlignment="Center" Margin="0,0,0,30" Grid.Row="0"/>

        <Grid Grid.Row="1" Margin="0,0,0,10" Width="400">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Tên khách hàng:" VerticalAlignment="Center" Grid.Column="0"/>
            <TextBox Text="{Binding TenKhachHang}" Grid.Column="1" Padding="2"/>
        </Grid>

        <Grid Grid.Row="2" Margin="0,0,0,30" Width="400">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Số điện thoại:" VerticalAlignment="Center" Grid.Column="0"/>
            <TextBox Text="{Binding SoDienThoai}" Grid.Column="1" Padding="2"/>
        </Grid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Content="Tham gia góp ý" Command="{Binding ThamGiaGopYCommand}" Width="100" Margin="10,0" Padding="5"/>
            <Button Content="Phản hồi" Command="{Binding FormPhanHoiCommand}" Width="100" Margin="10,0" Padding="5"/>
            <Button Content="Thoát" Command="{Binding ThoatCommand}" Width="100" Margin="10,0" Padding="5"/>
        </StackPanel>
    </Grid>
</UserControl>