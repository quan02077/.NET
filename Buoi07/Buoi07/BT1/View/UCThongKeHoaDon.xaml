<UserControl x:Class="Buoi07.BT1.View.UCThongKeHoaDon"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Buoi07.BT1.View"
        xmlns:vm="clr-namespace:Buoi07.BT1.ViewModel"
        mc:Ignorable="d"
        Height="450" Width="800">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Danh sách hóa đơn" FontSize="16" Margin="0,0,0,5"/>

        <DataGrid Grid.Row="1" Margin="0,0,0,20" AutoGenerateColumns="False" CanUserAddRows="False" ItemsSource="{Binding Customers}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="STT" Binding="{Binding STT}" Width="50"/>
                <DataGridTextColumn Header="Khách hàng" Binding="{Binding HoTen}" Width="150"/>
                <DataGridTextColumn Header="Sinh viên" Binding="{Binding HienThiSinhVien}" Width="80"/>
                <DataGridTextColumn Header="Nước uống" Binding="{Binding NuocUong}" Width="150"/>
                <DataGridTextColumn Header="Thức ăn" Binding="{Binding ThucAn}" Width="200"/>
                <DataGridTextColumn Header="Tổng tiền" Binding="{Binding TongTien, StringFormat={}{0:N0}}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="2" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Tổng khách hàng" VerticalAlignment="Center"/>
            <TextBox Grid.Column="1" IsReadOnly="True" Padding="2" Text="{Binding TongKhachHang, Mode=OneWay}"/>
        </Grid>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Tổng tiền thanh toán" VerticalAlignment="Center"/>
            <TextBox Grid.Column="1" IsReadOnly="True" Padding="2" Text="{Binding TongTienThanhToan, StringFormat={}{0:N0}, Mode=OneWay}"/>
        </Grid>
    </Grid>
</UserControl>
