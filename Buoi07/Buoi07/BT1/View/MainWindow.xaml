<Window x:Class="Buoi07.BT1.View.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Buoi07.BT1.View"
        xmlns:vm="clr-namespace:Buoi07.BT1.ViewModel"
        mc:Ignorable="d"
        Title="MainWindow" Height="550" Width="800">
    <Window.DataContext>
        <vm:MainVM/>
    </Window.DataContext>
    <Grid>
        <Menu VerticalAlignment="Top" Background="#F0F0F0" Padding="5">
            <MenuItem Header="Hệ thống"/>
            <MenuItem Header="Bán hàng">
                <MenuItem Header="Lập hóa đơn" Click="MnuLapHoaDon_Click"/>
                <MenuItem Header="Thống kê hóa đơn" Click="MnuThongKe_Click"/>
            </MenuItem>
        </Menu>
        <ContentControl x:Name="MainContent"/>
    </Grid>
</Window>
