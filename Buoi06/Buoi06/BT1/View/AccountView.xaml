<Window x:Class="Buoi06.BT1.View.AccountView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Buoi06.BT1.View"
        xmlns:vm="clr-namespace:Buoi06.BT1.ViewModel"
        mc:Ignorable="d"
        Title="AccountView" Height="500" Width="1000">
    <Window.DataContext>
        <vm:AccountVM/>
    </Window.DataContext>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock Text="DANH SÁCH TÀI KHOẢN NGÂN HÀNG" HorizontalAlignment="Center" FontSize="25" FontWeight="Bold"/>
        <Grid Grid.Row="1" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,5">
                <TextBlock Text="Số tài khoản: " FontSize="16" Width="150"/>
                <TextBox Width="300" Text="{Binding NewAccountNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Text="Tên khách hàng: " FontSize="16" Width="150" Margin="5,0,0,0"/>
                <TextBox Width="300" Text="{Binding NewCustomerName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
            <StackPanel  Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,5">
                <TextBlock Text="Địa chỉ: " FontSize="16" Width="150"/>
                <TextBox Width="300" Text="{Binding NewAddress, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Text="Thành phố: " FontSize="16" Width="150" Margin="5,0,0,0"/>
                <ComboBox Width="300" ItemsSource="{Binding Cities}" SelectedItem="{Binding SelectedCity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,5">
                <TextBlock Text="Số tiền: " FontSize="16" Width="150"/>
                <TextBox Width="300" Text="{Binding NewBalance, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Text="Tổng tiền: " FontSize="16" Width="150" Margin="5,0,0,0"/>
                <TextBlock Text="{Binding TotalBalance, StringFormat=N0}"/>
            </StackPanel>
        </Grid>
        <DataGrid Grid.Row="2" Margin="10" ItemsSource="{Binding Accounts}" SelectedItem="{Binding SelectedAccount}" AutoGenerateColumns="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="STT" Binding="{Binding STT}"/>
                <DataGridTextColumn Header="Số TK" Width="80" Binding="{Binding AccountNumber}"/>
                <DataGridTextColumn Header="Tên KH" Width="200" Binding="{Binding CustomerName}"/>
                <DataGridTextColumn Header="Địa chỉ" Width="200" Binding="{Binding Address}"/>
                <DataGridTextColumn Header="Thành phố" Width="150" Binding="{Binding City}"/>
                <DataGridTextColumn Header="Số tiền" Width="180" Binding="{Binding Balance, StringFormat=N0}"/>
            </DataGrid.Columns>
        </DataGrid>
        <StackPanel Orientation="Horizontal" Grid.Row="3" HorizontalAlignment="Center">
             <Button Content="{Binding AddButtonText}"
                Width="80"
                Height="30"
                Margin="5,0"
                Command="{Binding AddCommand}"/>
             <Button Content="Lưu"
                Width="80"
                Height="30"
                Margin="5,0"
                Command="{Binding SaveCommand}"/>
                <Button Content="Sửa"
                Width="80"
                Height="30"
                Margin="5,0"
                Command="{Binding EditCommand}"/>
            <Button Content="Xóa"
                Width="80"
                Height="30"
                Margin="5,0"
                Command="{Binding DeleteCommand}"/>
        </StackPanel>
    </Grid>
</Window>
