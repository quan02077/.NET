<UserControl x:Class="Buoi06.BT4.View.TaiKhoanUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="Buoi06.BT4.ViewModel"
             Background="White" Height="429" Width="840">
    
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="DANH SÁCH TÀI KHOẢN NGÂN HÀNG" 
                   Foreground="Blue" FontWeight="Bold" FontSize="16" 
                   HorizontalAlignment="Center" Margin="0,0,0,20"/>

        <Grid Grid.Row="1" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Số tài khoản:" VerticalAlignment="Center" Margin="5"/>
            <TextBox Grid.Row="0" Grid.Column="1" Margin="5" Padding="2" Text="{Binding NewAccountNumber}"/>

            <TextBlock Grid.Row="0" Grid.Column="2" Text="Tên khách hàng:" VerticalAlignment="Center" Margin="5"/>
            <TextBox Grid.Row="0" Grid.Column="3" Margin="5" Padding="2" Text="{Binding NewCustomerName}"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Địa chỉ:" VerticalAlignment="Center" Margin="5"/>
            <TextBox Grid.Row="1" Grid.Column="1" Margin="5" Padding="2" Text="{Binding NewAddress}"/>

            <TextBlock Grid.Row="1" Grid.Column="2" Text="Thành phố:" VerticalAlignment="Center" Margin="5"/>
            <ComboBox Grid.Row="1" Grid.Column="3" Margin="5" Padding="2" ItemsSource="{Binding Cities}" SelectedItem="{Binding SelectedCity}"/>

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Số tiền:" VerticalAlignment="Center" Margin="5"/>
            <TextBox Grid.Row="2" Grid.Column="1" Margin="5" Padding="2" Text="{Binding NewBalance}"/>
        </Grid>

        <DataGrid Grid.Row="2" AutoGenerateColumns="False" CanUserAddRows="False" AlternatingRowBackground="#F0F0F0" HeadersVisibility="Column" ItemsSource="{Binding Accounts}" SelectedItem="{Binding SelectedAccount}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="STT" Width="50" Binding="{Binding STT}"/>
                <DataGridTextColumn Header="Số TK" Width="100" Binding="{Binding AccountId}"/>
                <DataGridTextColumn Header="Tên KH" Width="150" Binding="{Binding AccountName}"/>
                <DataGridTextColumn Header="Địa chỉ" Width="200" Binding="{Binding Address}"/>
                <DataGridTextColumn Header="Thành phố" Width="120" Binding="{Binding City}"/>
                <DataGridTextColumn Header="Số tiền" Width="*" Binding="{Binding Balance}"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="3" Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,10">
                <TextBlock Text="Tổng tiền: " FontWeight="Bold" Foreground="Black"/>
                <TextBlock  FontWeight="Bold" Foreground="Red" Text="{Binding TotalBalance}"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="Thêm" Width="80" Height="25" Margin="5" Command="{Binding AddCommand}"/>
                <Button Content="Lưu" Width="80" Height="25" Margin="5" Command="{Binding SaveCommand}"/>
                <Button Content="Sửa" Width="80" Height="25" Margin="5" Command="{Binding EditCommand}"/>
                <Button Content="Xóa" Width="80" Height="25" Margin="5" Command="{Binding DeleteCommand}"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>