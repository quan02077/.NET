<Window x:Class="Buoi06.BT4.View.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Buoi06.BT4.ViewModel" 
        Title="Quản lý" Height="600" Width="900" WindowStartupLocation="CenterScreen">
    <Window.DataContext>
        <vm:AccountVM/>
    </Window.DataContext>
    <DockPanel>
        <Menu DockPanel.Dock="Top" Background="#F0F0F0" Padding="3">
            <MenuItem Header="Quản lý">
                <MenuItem Header="Nhân viên"/>
                <MenuItem Header="Tài khoản" Click="MenuItem_TaiKhoan_Click"/>
                <MenuItem Header="Sinh viên"/>
            </MenuItem>
        </Menu>

        <ContentControl x:Name="MainContentControl" Margin="10"/>
    </DockPanel>
</Window>