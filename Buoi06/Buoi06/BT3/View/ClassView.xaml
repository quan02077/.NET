<UserControl x:Class="Buoi06.BT3.View.ClassView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:Buoi06.BT3.View"
             xmlns:vm="clr-namespace:Buoi06.BT3.ViewModel"
             mc:Ignorable="d"
             d:DesignHeight="500" d:DesignWidth="800"
             Background="White">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
    </UserControl.Resources>
    <UserControl.DataContext>
        <vm:MainVM/>
    </UserControl.DataContext>
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.ColumnSpan="2" 
                   Text="QUẢN LÝ LỚP HỌC"
                   FontSize="24" FontWeight="Bold" 
                   HorizontalAlignment="Center" Margin="0,0,0,20"/>

        <GroupBox Grid.Row="1" Grid.Column="0" Header="Danh sách lớp - sinh viên" Margin="0,0,10,0">
            <TreeView Margin="5" ItemsSource="{Binding Classes}" SelectedItemChanged="TreeView_SelectedItemChanged">
                <TreeView.ItemTemplate>
                    <HierarchicalDataTemplate ItemsSource="{Binding Student}">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                        <HierarchicalDataTemplate.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding FullName}"/>
                            </DataTemplate>
                        </HierarchicalDataTemplate.ItemTemplate>
                    </HierarchicalDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>
        </GroupBox>

        <StackPanel Grid.Row="1" Grid.Column="1">

            <GroupBox Header="Chọn lớp" Margin="0,0,0,15">
                <ComboBox Margin="10" Height="25"
                          ItemsSource="{Binding Classes}"
                          DisplayMemberPath="Name"
                          SelectedItem="{Binding SelectedClass, Mode=TwoWay}"/>
            </GroupBox>

            <GroupBox Header="Thông tin sinh viên" Margin="0,0,0,15">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Mã SV:" VerticalAlignment="Center" Margin="0,5"/>
                    <TextBox Grid.Row="0" Grid.Column="1" Height="22" Margin="0,5"
                             Text="{Binding NewStudentId, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Họ tên:" VerticalAlignment="Center" Margin="0,5"/>
                    <TextBox Grid.Row="1" Grid.Column="1" Height="22" Margin="0,5"
                             Text="{Binding NewStudentName, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Địa chỉ:" VerticalAlignment="Center" Margin="0,5"/>
                    <TextBox Grid.Row="2" Grid.Column="1" Height="22" Margin="0,5"
                             Text="{Binding NewStudentAddress, UpdateSourceTrigger=PropertyChanged}"/>

                    <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
                        <Button Content="Cập nhật" Width="80" Height="25" Margin="0,0,10,0"
                                Command="{Binding AddStudentCommand}"/>
                        <Button Content="Xóa" Width="80" Height="25"
                                Command="{Binding DelStudentCommand}"/>
                    </StackPanel>
                </Grid>
            </GroupBox>

            <GroupBox Header="Thêm lớp" Margin="0,15,0,0">
                <StackPanel Margin="10">

                    <CheckBox x:Name="chkAddClass" 
                              Content="Bật chế độ thêm lớp"/>

                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0"
                                Visibility="{Binding ElementName=chkAddClass, Path=IsChecked, Converter={StaticResource BoolToVisConverter}}">

                        <TextBox Width="200" Height="25" Margin="0,0,10,0"
                                 Text="{Binding NewClass, UpdateSourceTrigger=PropertyChanged}"/>

                        <Button Content="Thêm lớp" Width="80" Height="25"
                                Command="{Binding AddClassCommand}"/>

                    </StackPanel>

                </StackPanel>
            </GroupBox>

        </StackPanel>
    </Grid>
</UserControl>