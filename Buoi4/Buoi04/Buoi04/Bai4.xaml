<Window x:Class="Buoi04.Bai4"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Buoi04"
        mc:Ignorable="d"
        Title="Bai4" Height="600" Width="1000">
    <Window.Resources>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Width" Value="100"/>
        </Style>
        <Style x:Key="txtBox" TargetType="TextBox">
            <Setter Property="Width" Value="300"/>
            <Setter Property="Height" Value="20"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Menu>
            <MenuItem Header="Hệ thống" Margin="10"/>
            <MenuItem Header="Danh mục" Margin="10"/>
            <MenuItem Header="Chấm công" Margin="10"/>
        </Menu>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Margin="10">
                <Label Content="Phòng ban" FontWeight="Bold" Margin="0,0,0,10"/>
                <TreeView x:Name="tv_PhongBan" Height="300" Width="250" Margin="0,0,0,10" SelectedItemChanged="tvPhongBan_SelectedItemChanged">
                    <TreeViewItem Header="Giám đốc">
                        <TreeViewItem Header="Hoan (NV54)">
                            <TreeViewItem Header="Lê Trọng Tấn"/>
                            <TreeViewItem Header="0987635282"/>
                        </TreeViewItem>
                    </TreeViewItem>
                    <TreeViewItem Header="Kế hoạch">
                        <TreeViewItem Header="Khang (NV83)">
                            <TreeViewItem Header="Bùi Đình Túy"/>
                            <TreeViewItem Header="028957686"/>
                        </TreeViewItem>
                        <TreeViewItem Header="Lan (NV23)">
                            <TreeViewItem Header="Lê Lợi"/>
                            <TreeViewItem Header="078938292"/>
                        </TreeViewItem>
                    </TreeViewItem>
                    <TreeViewItem Header="Giám đốc">
                        <TreeViewItem Header="Hương (NV51)">
                            <TreeViewItem Header="Sư Vạn Hạnh"/>
                            <TreeViewItem Header="02856933"/>
                        </TreeViewItem>
                    </TreeViewItem>
                </TreeView>
                <Label Content="Phòng ban" Margin="0,0,0,10"/>
                <TextBox x:Name="txt_PhongBan" Width="250" Margin="0,0,0,10"/>
                <Button Content="Thêm phòng ban" Width="250" Margin="0,0,0,10" Click="btn_ThemPB"/>
                <Button Content="Xóa phòng ban" Width="250" Margin="0,0,0,10" Click="btn_XoaPB"/>
            </StackPanel>
            <GroupBox Header="HỒ SƠ NHÂN VIÊN" Grid.Column="1" Margin="20" Width="690">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Label Content="Mã số" Width="150"/>
                    <Label Content="Họ tên" Width="150" Grid.Row="1"/>
                    <Label Content="Địa chỉ" Width="150" Grid.Row="2"/>
                    <Label Content="Điện thoại" Width="150" Grid.Row="3"/>
                    <Label Content="Phòng ban" Width="150" Grid.Row="4"/>
                    <TextBox x:Name="txt_MaSo" Style="{StaticResource txtBox}" Grid.Row="0" Grid.Column="1"/>
                    <TextBox x:Name="txt_HoTen" Style="{StaticResource txtBox}" Grid.Row="1" Grid.Column="1"/>
                    <TextBox x:Name="txt_DiaChi" Style="{StaticResource txtBox}" Grid.Row="2" Grid.Column="1"/>
                    <TextBox x:Name="txt_DienThoai" Style="{StaticResource txtBox}" Grid.Row="3" Grid.Column="1"/>
                    <TextBlock x:Name="show_PhongBan" Width="300" Height="20" Grid.Row="4" Grid.Column="1" Background="#f1d08d"/>
                    <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal" Margin="10">
                        <Button Style="{StaticResource PrimaryButton}" Content="Thêm" Click="btn_Them"/>
                        <Button Style="{StaticResource PrimaryButton}" Content="Sửa" Margin="10,0,0,0" Click="btn_Sua"/>
                        <Button Style="{StaticResource PrimaryButton}" Content="Xóa" Margin="10,0,0,0" Click="btn_Xoa"/>
                        <Button Style="{StaticResource PrimaryButton}" Content="Thoát" Margin="10,0,0,0" Click="btn_Thoat"/>
                    </StackPanel>
                </Grid>
            </GroupBox>
        </Grid>
    </Grid>
</Window>
