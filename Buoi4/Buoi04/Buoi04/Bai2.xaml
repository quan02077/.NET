<Window x:Class="Buoi04.Bai2"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Buoi04"
        mc:Ignorable="d"
        Title="Bai2" Height="500" Width="850">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Column="0" HorizontalAlignment="Left" Margin="22,33,0,0" TextWrapping="Wrap" Text="Mã phòng:" VerticalAlignment="Top"/>
        <TextBox x:Name="txtMaPhong" Grid.Column="0" HorizontalAlignment="Left" Margin="22,67,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="268"/>
        <TextBlock Grid.Column="0" HorizontalAlignment="Left" Margin="22,117,0,0" TextWrapping="Wrap" Text="Tên phòng ban:" VerticalAlignment="Top"/>
        <TextBox x:Name="txtTenPhong" Grid.Column="0" HorizontalAlignment="Left" Margin="22,153,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="268"/>
        <Button Content="Thêm phòng ban" HorizontalAlignment="Left" Margin="89,207,0,0" VerticalAlignment="Top" Width="163" Click="ADD_Click"/>
        <TextBlock Grid.Column="1" HorizontalAlignment="Left" Margin="10,36,0,0" TextWrapping="Wrap" Text="Phòng ban" VerticalAlignment="Top" FontWeight="Bold"/>
        <TreeView x:Name="txtPhongBan" Grid.Column="1" Margin="10,67,63,237" Grid.RowSpan="2" SelectedItemChanged="tvPhongBan_SelectedItemChanged"/>
        <GroupBox Header="Thông tin phòng ban đã chọn"
          Grid.Column="1" Grid.Row="1" Margin="10,10,10,10">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Phòng ban:" Grid.Row="0"/>
                <TextBlock x:Name="txtTenPhongBan" Grid.Row="0" Grid.Column="1"/>
                <TextBlock x:Name="txtChucVu" Grid.Row="1" Grid.Column="1" Margin="0,5,0,0"/>
                <Button Content="Thoát"
                Grid.Row="2"
                Grid.ColumnSpan="2"
                Width="100"
                Margin="0,10,0,0"
                HorizontalAlignment="Center" Click="QUIT_Click"/>
            </Grid>
        </GroupBox>
    </Grid>
</Window>
