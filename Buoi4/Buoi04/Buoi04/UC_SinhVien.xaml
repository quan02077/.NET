<UserControl x:Class="Buoi04.UC_SinhVien"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Buoi04"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Grid.Row="2" Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Label Content="Mã SV" Width="150"/>
        <Label Content="Họ tên" Grid.Row="1" Width="150"/>
        <Label Content="Giới tính" Grid.Row="2" Width="150"/>
        <Label Content="Sở thích" Grid.Row="3" Width="150"/>
        <Label Content="Lớp" Grid.Row="4" Width="150"/>
        <Label Content="Môn học" Grid.Row="5" Width="150"/>
        <TextBox Grid.Column="1" Width="610" Height="20"/>
        <TextBox Grid.Row="1" Grid.Column="1" Width="610" Height="20"/>
        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
            <RadioButton Content="Nam" Margin="0,5,10,0"/>
            <RadioButton Content="Nữ" Margin="0,5,10,0"/>
        </StackPanel>
        <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal">
            <CheckBox Content="Thể thao" Margin="0,5,15,0"/>
            <CheckBox Content="Âm nhạc" Margin="0,5,15,0"/>
            <CheckBox Content="Du lịch" Margin="0,5,15,0"/>
        </StackPanel>
        <ComboBox Grid.Row="4" Grid.Column="1">
            <ComboBoxItem Content="CNTT"/>
            <ComboBoxItem Content="Kế toán"/>
            <ComboBoxItem Content="Quản trị kinh doanh"/>
        </ComboBox>
        <ListBox Grid.Row="5" Grid.Column="1" Margin="0,5,0,0">
            <ListBoxItem Content="Lập trình C#"/>
            <ListBoxItem Content="Thiết kế web"/>
            <ListBoxItem Content="WPF nâng cao"/>
        </ListBox>
        <StackPanel Grid.Row="6" Grid.Column="1" Orientation="Horizontal" Margin="20" HorizontalAlignment="Center">
            <Button Content="Lưu" Margin="10" Width="100"/>
            <Button x:Name="btn_QUITSV" Content="Thoát" Click="btn_QUITSV_Click" Margin="10" Width="100"/>
        </StackPanel>
    </Grid>
</UserControl>
