<Window x:Class="Buoi12.BT1.DangNhap"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Buoi12.BT1"
        mc:Ignorable="d"
        Title="DangNhap" Height="450" Width="820">
    <Window.DataContext>
        <local:DangNhapVM/>
    </Window.DataContext>
    <Grid Margin="10">
        <TextBlock Text="Đăng Nhập Hệ Thống" FontSize="30" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,10,0,339"/>
        <StackPanel Margin="20,80,20,20">
            <TextBlock Text="Tên đăng nhập:" FontSize="16" Margin="10" HorizontalAlignment="Left" VerticalAlignment="Top"/>
            <TextBox Width="720" Height="30" Margin="10" HorizontalAlignment="Left" Text="{Binding TenDangNhap, UpdateSourceTrigger=PropertyChanged}"/>
            <TextBlock Text="Mật khẩu:" FontSize="16" Margin="10" HorizontalAlignment="Left" VerticalAlignment="Top"/>
            <TextBox Width="720" Height="30" Margin="10" HorizontalAlignment="Left" Text="{Binding MatKhau, UpdateSourceTrigger=PropertyChanged}"/>
            <Button Content="Đăng Nhập" Width="720" Height="50" Margin="10" HorizontalAlignment="Left" Command="{Binding DangNhapCmd}"/>
            <TextBlock Text="Sai tên đăng nhập hoặc mật khẩu! Vui lòng nhập lại" FontSize="16" Margin="10" HorizontalAlignment="Left" VerticalAlignment="Top" Foreground="Red" Visibility="{Binding ThongBaoVisibility}"/>
        </StackPanel>
    </Grid>
</Window>
