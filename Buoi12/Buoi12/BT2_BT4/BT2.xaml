<Window x:Class="Buoi12.BT2_BT4.BT2"
        x:Name="frmMain"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Buoi12.BT2_BT4"
        mc:Ignorable="d"
        Title="BT2" Height="700" Width="1100">
    <Window.DataContext>
        <local:BT2VM/>
    </Window.DataContext>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Background="#F0F4F8">
            <StackPanel Margin="10,20,10,10">

                <TextBlock Text="HỆ THỐNG CỬA HÀNG" FontWeight="Bold" FontSize="18" Margin="0,0,0,10"/>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                    <TextBlock Text="Xin chào " FontSize="13"/>
                    <TextBlock FontSize="13" Text="{Binding TenDangNhap}"/>
                </StackPanel>

                <Expander Header="Hệ thống" IsExpanded="True" Margin="0,0,0,10">
                    <StackPanel Margin="10,5,10,0">
                        <Button Content="Đổi mật khẩu" Margin="0,0,0,5" Padding="0,4,0,4" Background="#E1E1E1" BorderBrush="#ADADAD"/>
                        <Button Content="Sao lưu" IsEnabled="{Binding IsQuanLy}" Margin="0,0,0,5" Padding="0,4,0,4" Background="#E1E1E1" BorderBrush="#ADADAD"/>
                        <Button Content="Phục hồi" IsEnabled="{Binding IsQuanLy}" Margin="0,0,0,5" Padding="0,4,0,4" Background="#E1E1E1" BorderBrush="#ADADAD"/>
                        <Button Content="Đăng xuất" Command="{Binding DangNhapView}" CommandParameter="{Binding ElementName=frmMain}" Margin="0,0,0,5" Padding="0,4,0,4" Background="#E1E1E1" BorderBrush="#ADADAD" />
                    </StackPanel>
                </Expander>

                <Expander Header="Danh mục" IsExpanded="True" Margin="0,0,0,10">
                    <StackPanel Margin="10,5,10,0">
                        <Button Content="Loại sản phẩm" Margin="0,0,0,5" Padding="0,4,0,4" Background="#E1E1E1" BorderBrush="#ADADAD" IsEnabled="{Binding IsQuanLy}"/>
                        <Button Content="Sản phẩm" Margin="0,0,0,5" Padding="0,4,0,4" Background="#E1E1E1" BorderBrush="#ADADAD" IsEnabled="{Binding IsQuanLy}"/>
                        <Button Content="Nhà cung cấp" Margin="0,0,0,5" Padding="0,4,0,4" Background="#E1E1E1" BorderBrush="#ADADAD" IsEnabled="{Binding IsQuanLy}"/>
                        <Button Content="Nhân viên" Margin="0,0,0,5" Padding="0,4,0,4" Background="#E1E1E1" BorderBrush="#ADADAD" IsEnabled="{Binding IsQuanLy}"/>
                    </StackPanel>
                </Expander>

                <Expander Header="Nhập hàng" IsExpanded="True" Margin="0,0,0,10">
                    <StackPanel Margin="10,5,10,0">
                        <Button Content="Lập phiếu nhập" Margin="0,0,0,5" Padding="0,4,0,4" Background="#E1E1E1" BorderBrush="#ADADAD" Command="{Binding PhieuNhapView}" IsEnabled="{Binding IsNhanVienKho}"/>
                    </StackPanel>
                </Expander>

                <Expander Header="Thống kê" IsExpanded="True" Margin="0,0,0,10">
                    <StackPanel Margin="10,5,10,0">
                        <Button Content="Thống kê tồn kho" Margin="0,0,0,5" Padding="0,4,0,4" Background="#E1E1E1" BorderBrush="#ADADAD" IsEnabled="{Binding IsNhanVienBanHang}"/>
                        <Button Content="Thống kê nhập" Margin="0,0,0,5" Padding="0,4,0,4" Background="#E1E1E1" BorderBrush="#ADADAD" IsEnabled="{Binding IsNhanVienKho}"/>
                    </StackPanel>
                </Expander>

            </StackPanel>
        </Grid>

        <Grid Grid.Column="1" Background="White">
            <ContentControl Content="{Binding CurrentView}"/>
        </Grid>

    </Grid>
</Window>
