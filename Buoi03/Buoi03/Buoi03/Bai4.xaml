<Window x:Class="Buoi03.Bai4"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Buoi03"
        mc:Ignorable="d"
        Title="Bai4" Height="500" Width="800" Background="#ddebea">
    <Grid Margin="10, 20, 10, 20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Label Content="Form Thông tin - Sở thích cá nhân" HorizontalAlignment="Center" FontSize="25" FontWeight="bold" Foreground="#2C3E50"/>
        <TabControl Grid.Row="1">
            <TabItem Header="Thông tin cá nhân">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Nhập họ tên:" FontWeight="Bold" Margin="10" Width="200"/>
                    <TextBlock Text="Ngày sinh:" FontWeight="Bold" Margin="10" Grid.Row="1" Width="200"/>
                    <TextBlock Text="Giới tính:" FontWeight="Bold" Margin="10" Grid.Row="2" Width="200"/>
                    <TextBlock Text="Quốc tịch:" FontWeight="Bold" Margin="10" Grid.Row="3" Width="200"/>
                    <TextBlock Text="Nghề nghiệp:" FontWeight="Bold" Margin="10" Grid.Row="4" Width="200"/>
                    <TextBox x:Name="txtHoTen" Width="300" Height="30" Margin="10,10,410,10" Grid.Column="1"/>
                    <DatePicker x:Name="txtDate" Width="500" Height="30" Margin="10,10,210,10" Grid.Column="1" Grid.Row="1"/>
                    <RadioButton x:Name="txtNam" Content="Nam" Margin="10,10,0,10" Grid.Column="1" Grid.Row="2"/>
                    <RadioButton x:Name="txtNu" Content="Nữ" Margin="80,10,0,10" Grid.Column="1" Grid.Row="2"/>
                    <ComboBox x:Name="txtQuocTich" Width="500" Height="30" Margin="10,10,210,10" Grid.Column="1" Grid.Row="3">
                        <ComboBoxItem Content="Việt Nam"/>
                        <ComboBoxItem Content="Bồ Đào Nha"/>
                        <ComboBoxItem Content="Anh"/>
                        <ComboBoxItem Content="Pháp"/>
                        <ComboBoxItem Content="Đức"/>
                        <ComboBoxItem Content="Argentina"/>
                    </ComboBox>
                    <TextBox x:Name="txtNghe" Width="500" Height="30" Margin="10,10,210,10" Grid.Column="1" Grid.Row="4"/>
                </Grid>
            </TabItem>
            <TabItem Header="Sở thích - ghi chú">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <GroupBox Margin="10,20" Header="Sở thích cá nhân" Width="350">
                        <StackPanel Margin="10">
                            <CheckBox x:Name="txtDocSach" Content="Đọc sách" Margin="0,5"/>
                            <CheckBox x:Name="txtNgheNhac" Content="Nghe nhạc" Margin="0,5"/>
                            <CheckBox x:Name="txtTheThao" Content="Thể thao" Margin="0,5"/>
                            <CheckBox x:Name="txtDuLich" Content="Du lịch" Margin="0,5"/>
                            <CheckBox x:Name="txtChoiGame" Content="Chơi game" Margin="0,5"/>
                        </StackPanel>
                    </GroupBox>
                    <GroupBox Margin="10,20" Header="Kỹ năng" Grid.Column="1" Width="360">
                        <ListBox x:Name="txtKyNang" SelectionMode="Multiple" Margin="5">
                            <ListBoxItem Content="C# / .NET"/>
                            <ListBoxItem Content="WPF / XAML"/>
                            <ListBoxItem Content="SQL Server"/>
                            <ListBoxItem Content="HTML / CSS"/>
                            <ListBoxItem Content="Giao tiếp / Làm việc nhóm"/>
                        </ListBox>
                    </GroupBox>
                </Grid>
            </TabItem>
        </TabControl>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,11" Width="235" >
            <Button Content="Hiện thông tin" Width="130" Height="35" Background="#03ab68" Foreground="White" Click="Show_Click" />
            <Button Content="Thoát" Width="100" Height="35" Background="#E74C3C" Foreground="White" Click="Quit_Click" />
        </StackPanel>
    </Grid>
</Window>
