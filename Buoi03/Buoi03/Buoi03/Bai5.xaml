<Window x:Class="Buoi03.Bai5"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Buoi03"
        mc:Ignorable="d"
        Title="Bai5" Height="600" Width="950">
    <Grid Margin="10,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Label Content="Thêm nhân viên" HorizontalAlignment="Center" FontSize="26" FontWeight="Bold" Foreground="blue"/>
        <Grid Grid.Row="1" Margin="10" HorizontalAlignment="Left">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Text="Mã nhân viên:" Margin="10" VerticalAlignment="Center" Width="150"/>
            <TextBox x:Name="txtMaNV" Width="250" Margin="10" Grid.Column="1"/>
            <TextBlock Text="Họ tên:" Margin="10" VerticalAlignment="Center" Grid.Row="1" Width="150"/>
            <TextBox x:Name="txtHoTen" Width="250" Margin="10" Grid.Column="1" Grid.Row="1"/>
            <TextBlock Text="Giới tính:" Margin="10" VerticalAlignment="Center" Grid.Row="2" Width="150"/>
            <RadioButton x:Name="txtNam" Content="Nam" Margin="10,10,0,10" Grid.Column="1" Grid.Row="2"/>
            <RadioButton x:Name="txtNu" Content="Nữ" Margin="80,10,0,10" Grid.Column="1" Grid.Row="2"/>
            <TextBlock Text="Ngày sinh:" Margin="10" VerticalAlignment="Center" Grid.Row="3" Width="150"/>
            <DatePicker x:Name="txtDate" Width="250" Margin="10" Grid.Column="1" Grid.Row="3"/>
            <TextBlock Text="Phòng ban:" Margin="10" VerticalAlignment="Center" Grid.Row="4" Width="150"/>
            <ComboBox x:Name="txtPhongBan" Width="250" Margin="10" Grid.Column="1" Grid.Row="4">
                <ComboBoxItem Content="Nhân sự"/>
                <ComboBoxItem Content="Kế toán"/>
                <ComboBoxItem Content="IT"/>
                <ComboBoxItem Content="Marketing"/>
                <ComboBoxItem Content="Bán hàng"/>
            </ComboBox>
            <TextBlock Text="Ghi chú: " Margin="10" VerticalAlignment="Center" Grid.Row="5" Width="150"/>
            <TextBox x:Name="txtGhiChu" Width="250" Height="60" Margin="10" Grid.Column="1" Grid.Row="5"/>
        </Grid>
        <Grid Grid.Row="1" Margin="455,12,0,13" HorizontalAlignment="Left">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Text="Loại hồ sơ:" Margin="10" VerticalAlignment="Top" Width="150" HorizontalAlignment="Left"/>
            <StackPanel Grid.Column="1">
                <RadioButton x:Name="txtHoSoThuViec" Content="Thử việc" Margin="5"/>
                <RadioButton x:Name="txtHopDongNam" Content="Hợp đồng năm" Margin="5"/>
                <RadioButton x:Name="txtHoSoHopDong" Content="Chính thức" Margin="5"/>
            </StackPanel>
            <StackPanel Grid.Row="1" Margin="10">
                <TextBlock Text="Giấy tờ nộp kèm:" Margin="10" VerticalAlignment="Top" Width="150" HorizontalAlignment="Left"/>
                <TextBlock Text="Tên giấy tờ: " Margin="10"/>
                <TextBox x:Name="txtTenGiayTo" Width="200" Margin="10"/>
                <Button Content="Thêm giấy tờ" Width="100" HorizontalAlignment="Center" Click="btn_ThemGiayTo_Click" Margin="10"/>
            </StackPanel>
            <ListBox x:Name="txtGiayTo" Grid.Row="1" Grid.Column="1" Width="200" Height="120" Margin="10">
                <ListBoxItem Content="Giấy khám sức khỏe"/>
                <ListBoxItem Content="Bảng điểm"/>
                <ListBoxItem Content="Chứng chỉ C Tin học"/>
                <ListBoxItem Content="Chứng chỉ B1 Anh văn"/>
            </ListBox>
            <TextBlock Text="Năng khiếu: " Margin="10" Width="150" Grid.Row="3" HorizontalAlignment="Left"/>
            <StackPanel Grid.Row="2" Grid.Column="1" Margin="10">
                <CheckBox x:Name="txtTheThao" Content="Thể thao" Margin="10"/>
                <CheckBox x:Name="txtAmNhac" Content="Âm nhạc" Margin="10"/>
                <CheckBox x:Name="txtGiaoTiep" Content="Giao tiếp" Margin="10"/>
            </StackPanel>
        </Grid>
        <StackPanel Grid.Row="2" Margin="0,52,0,0" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Content="Thêm" Width="100" HorizontalAlignment="Left" Click="btn_ThemNV_Click" Margin="10"/>
            <Button Content="Xóa" Width="100" HorizontalAlignment="Left" Click="btn_XoaNV_Click" Margin="10"/>
            <Button Content="Thoát" Width="100" HorizontalAlignment="Left" Click="btn_Thoat_Click" Margin="10"/>
        </StackPanel>
    </Grid>
</Window>
