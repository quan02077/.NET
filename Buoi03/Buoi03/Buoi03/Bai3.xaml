<Window x:Class="Buoi03.Bai3"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Buoi03"
        mc:Ignorable="d"
        Title="Bai3" Height="550" Width="880">
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <GroupBox Header="Thông tin đặt món" Margin="10">
            <Grid Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="220"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Tên khách hàng:" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="10"/>
                <TextBox x:Name="txtTenKhachHang" Grid.Row="0" Grid.Column="1" Width="200" Margin="10"/>
                <TextBlock Text="Số điện thoại:" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="10"/>
                <TextBox x:Name="txtSoDienThoai" Grid.Row="1" Grid.Column="1" Width="200" Margin="10"/>
                <TextBlock Text="Chọn bàn" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Margin="10"/>
                <ComboBox x:Name="cmbChonBan" Grid.Row="2" Grid.Column="1" Width="200" Margin="10">
                    <ComboBoxItem Content="Bàn 1"/>
                    <ComboBoxItem Content="Bàn 2"/>
                    <ComboBoxItem Content="Bàn 3"/>
                    <ComboBoxItem Content="Bàn 4"/>
                    <ComboBoxItem Content="Bàn 5"/>
                </ComboBox>
                <TextBlock Text="Chọn món ăn:" Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" Margin="10"/>
                <ComboBox x:Name="cmbChonMonAn" Grid.Row="3" Grid.Column="1" Width="200" Margin="10">
                    <ComboBoxItem Content="Phở"/>
                    <ComboBoxItem Content="Bún chả"/>
                    <ComboBoxItem Content="Cơm tấm"/>
                    <ComboBoxItem Content="Gỏi cuốn"/>
                    <ComboBoxItem Content="Bánh mì"/>
                </ComboBox>
                <Button Click="btn_ThemMon" Grid.Row="5" Grid.Column="1" Content="Thêm món" Width="100" HorizontalAlignment="Right" Margin="10"/>
            </Grid>
        </GroupBox>
        <GroupBox Header="Thông tin hiển thị" Grid.Column="1" Margin="10">
            <StackPanel Margin="10">
                <TextBlock Text="Thông tin khách hàng" FontWeight="Bold" Margin="10"/>
                <TextBox x:Name="show_Info" Height="70" Margin="10" Width="340"/>
                <TextBlock Text="Danh sách món đã chọn" FontWeight="Bold" Margin="10"/>
                <ListBox x:Name="show_FoodList" Height="180" Margin="10" Width="340" Padding="2" VerticalContentAlignment="Top" MinHeight="0"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="10">
                    <Button Click="btn_XoaMon" Content="Xóa món" Width="100" Margin="5,0,0,0"/>
                    <Button Click="btn_DatMon" Content="Đặt món" Width="100" Margin="5,0,0,0"/>
                </StackPanel>
            </StackPanel>
        </GroupBox>
    </Grid>
</Window>
