<Window x:Class="Buoi03.Bai2"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Buoi03"
        mc:Ignorable="d"
        Title="Bai2" Height="650" Width="620" Background="#ddebea">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Form Thông tin - Sở thích cá nhân" FontSize="20" HorizontalAlignment="Center" FontWeight="Bold" Foreground="#2C3E50"/>
        <TabControl Grid.Row="1" Background="White" Margin="10" Padding="5" x:Name="TabControl">
            <TabItem Header="Nhập thông tin cá nhân">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="10" VerticalAlignment="Top">
                        <TextBlock Text="Họ và tên:" FontWeight="Bold" Margin="0,10,0,5"/>
                        <TextBox x:Name="txtHoTen" Width="200"/>
                        <TextBlock Text="Giới tính:" Margin="0,10,0,5" FontWeight="Bold"/>
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="txtNam" Content="Nam" Margin="10,0"/>
                            <RadioButton x:Name="txtNu" Content="Nữ" Margin="10,0"/>
                        </StackPanel>
                        <TextBlock Text="Ngày sinh:" Margin="0,10,0,5" FontWeight="Bold"/>
                        <DatePicker x:Name="txtDate" Width="200"/>
                        <TextBlock Text="Quê quán:" Margin="0,10,0,5" FontWeight="Bold"/>
                        <ComboBox x:Name="txtQueQuan" Width="200">
                            <ComboBoxItem Content="Hà Nội"/>
                            <ComboBoxItem Content="TP.HCM"/>
                            <ComboBoxItem Content="Đà Nẵng"/>
                            <ComboBoxItem Content="Cần Thơ"/>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Margin="10" VerticalAlignment="Top" Grid.Column="1">
                        <TextBlock Text="Nghề nghiệp: " FontWeight="Bold" Margin="0,10,0,5"/>
                        <TextBox x:Name="txtNghe" Width="280"/>
                        <TextBlock Text="Sở thích: " FontWeight="Bold" Margin="0,10,0,5"/>
                        <CheckBox x:Name="txtDocSach" Content="Đọc sách" Margin="0,5"/>
                        <CheckBox x:Name="txtNgheNhac" Content="Nghe nhạc" Margin="0,5"/>
                        <CheckBox x:Name="txtTheThao" Content="Thể thao" Margin="0,5"/>
                        <CheckBox x:Name="txtDuLich" Content="Du lịch" Margin="0,5"/>
                        <TextBlock Text="Kỹ năng: " FontWeight="Bold" Margin="0,10,0,5"/>
                        <ListBox x:Name="txtKyNang" Width="280" Height="100" SelectionMode="Multiple">
                            <ListBoxItem Content="C# / .NET"/>
                            <ListBoxItem Content="WPF / XAML"/>
                            <ListBoxItem Content="SQL Server"/>
                            <ListBoxItem Content="HTML / CSS"/>
                            <ListBoxItem Content="Kỹ năng giao tiếp"/>
                        </ListBox>
                        <TextBlock Text="Ghi chú: " FontWeight="Bold" Margin="0,10,0,5"/>
                        <TextBox x:Name="txtGhiChu" Height="60"/>
                    </StackPanel>
                </Grid>
            </TabItem>
            <TabItem Header="Xem thông tin đã nhập">
                <Grid Margin="15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="10" VerticalAlignment="Top">
                        <TextBlock Text="Họ và tên:" FontWeight="Bold"/>
                        <TextBlock x:Name="lblHoTen" Margin="0,0,0,10"/>
                        <TextBlock Text="Giới tính:" FontWeight="Bold"/>
                        <TextBlock x:Name="lblGioiTinh" Margin="0,0,0,10"/>

                        <TextBlock Text="Ngày sinh:" FontWeight="Bold"/>
                        <TextBlock x:Name="lblNgaySinh" Margin="0,0,0,10"/>
                        <TextBlock Text="Quốc tịch:" FontWeight="Bold"/>
                        <TextBlock x:Name="lblQuocTich" Margin="0,0,0,10"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="10" VerticalAlignment="Top">
                        <TextBlock Text="Nghề nghiệp:" FontWeight="Bold"/>
                        <TextBlock x:Name="lblNgheNghiep" Margin="0,0,0,10"/>
                        <TextBlock Text="Sở thích:" FontWeight="Bold"/>
                        <TextBlock x:Name="lblSoThich" Margin="0,0,0,10"/>
                        <TextBlock Text="Kỹ năng" FontWeight="Bold"/>
                        <TextBlock x:Name="lblKyNang" Margin="0,0,0,10"/>
                        <TextBlock Text="Ghi chú:" FontWeight="Bold"/>
                        <TextBlock x:Name="lblGhiChu" Margin="0,0,0,10" TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,11" Width="224" >
            <Button Content="Xem thông tin" Width="130" Height="35" Background="#3498DB" Foreground="White" Click="Show_Click" />
            <Button Content="Thoát" Width="100" Height="35" Background="#E74C3C" Foreground="White" Click="Quit_Click" />
        </StackPanel>
    </Grid>
</Window>
