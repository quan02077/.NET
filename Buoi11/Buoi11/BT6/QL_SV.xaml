<Window x:Class="Buoi11.BT6.QL_SV"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Buoi11.BT6"
        mc:Ignorable="d"
        Title="QL_SV" Height="450" Width="800">
    <Window.DataContext>
        <local:SinhVienVM/>
    </Window.DataContext>
    <Grid Margin="15">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1.5*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Margin="0,0,15,0">
            <TextBlock Text="THÔNG TIN SINH VIÊN" FontWeight="Bold" FontSize="16" Margin="0,0,0,15"/>

            <TextBlock Text="Mã sinh viên:"/>
            <TextBox Margin="0,5,0,10" Padding="2" IsEnabled="{Binding IsMaSVEnabled}"
         Text="{Binding MaSV, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"/>

            <TextBlock Text="Họ tên:"/>
            <TextBox Margin="0,5,0,10" Padding="2" 
         Text="{Binding TenSV, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"/>

            <TextBlock Text="Giới tính:"/>
            <StackPanel Orientation="Horizontal" Margin="10,5,0,5">
                <RadioButton Content="Nam" Margin="0,5,0,0" GroupName="GioiTinh" IsChecked="{Binding IsNam}"/>
                <RadioButton Content="Nữ" Margin="10,5,0,0" GroupName="GioiTinh" IsChecked="{Binding IsNu}"/>
            </StackPanel>

            <TextBlock Text="Ngày sinh:"/>
            <DatePicker Margin="0,5,0,10" Padding="2" SelectedDate="{Binding NgaySinh}"/>

            <TextBlock Text="Lớp:"/>
            <ComboBox Margin="0,5,0,15" Padding="2" ItemsSource="{Binding DS_Lop}" SelectedItem="{Binding SelectedLop}" DisplayMemberPath="TenLop" SelectedValuePath="MaLop"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Thêm" Width="50" Margin="0,0,5,0" Padding="3" Command="{Binding ThemCmd}"/>
                <Button Content="Sửa" Width="50" Margin="0,0,5,0" Padding="3" Command="{Binding SuaCmd}"/>
                <Button Content="Lưu" Width="50" Margin="0,0,5,0" Padding="3" Background="Blue" Foreground="White" Command="{Binding LuuCmd}"/>
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Column="1">
            <TextBlock Text="DANH SÁCH SINH VIÊN" FontWeight="Bold" FontSize="16" Margin="0,0,0,15"/>

            <DataGrid AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" Height="320" ItemsSource="{Binding DS_SinhVien}" SelectedItem="{Binding SelectedSinhVien}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Mã SV" Width="*" Binding="{Binding MaSinhVien}"/>
                    <DataGridTextColumn Header="Họ tên" Width="1.5*" Binding="{Binding HoTen}"/>
                    <DataGridTextColumn Header="Giới tính" Width="0.8*" Binding="{Binding GioiTinh}"/>

                    <DataGridTextColumn Header="Ngày sinh" Width="*" Binding="{Binding NgaySinh, StringFormat=dd/MM/yyyy}"/>
                    <DataGridTextColumn Header="Lớp" Width="*" Binding="{Binding Lop.TenLop}"/>
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>
    </Grid>
</Window>
