<Window x:Class="Buoi11.BT4.MainVIew"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Buoi11.BT4"
        mc:Ignorable="d"
        Title="QL_SV" Height="450" Width="800">
    <Window.DataContext>
        <local:MainVM/>
    </Window.DataContext>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Background="#2C3E50">
            <StackPanel Margin="0,25,0,0">
                <TextBlock Text="HỆ THỐNG" Foreground="White" FontSize="20" FontWeight="Bold" 
                           FontFamily="Georgia, Times New Roman, Serif" Margin="25,0,0,30"/>

                <Border Background="#34495E" Margin="15,0,15,15" CornerRadius="3" Padding="5">
                    <Expander IsExpanded="True">
                        <Expander.Header>
                            <TextBlock Text="Danh mục" Foreground="White" FontWeight="Bold" 
                                       FontFamily="Georgia, Times New Roman, Serif" FontSize="15" Margin="5,0,0,0"/>
                        </Expander.Header>

                        <StackPanel Margin="30,15,0,5">

                            <Button Content="Khoa" Command="{Binding ShowKhoaCommand}"
                                Background="Transparent" BorderThickness="0" Foreground="White"
                                FontFamily="Georgia, Times New Roman, Serif" FontSize="14" FontWeight="Bold" 
                                Cursor="Hand" HorizontalAlignment="Left" Margin="0,0,0,15"/>

                            <Button Content="Lớp" Command="{Binding ShowLopCommand}"
                                Background="Transparent" BorderThickness="0" Foreground="White"
                                FontFamily="Georgia, Times New Roman, Serif" FontSize="14" FontWeight="Bold" 
                                Cursor="Hand" HorizontalAlignment="Left" Margin="0,0,0,15"/>

                            <Button Content="Môn học" Command="{Binding ShowMonHocCommand}"
                                Background="Transparent" BorderThickness="0" Foreground="White"
                                FontFamily="Georgia, Times New Roman, Serif" FontSize="14" FontWeight="Bold" 
                                Cursor="Hand" HorizontalAlignment="Left" Margin="0,0,0,15"/>

                            <Button Content="Sinh viên" Command="{Binding ShowSinhVienCommand}"
                                Background="Transparent" BorderThickness="0" Foreground="White"
                                FontFamily="Georgia, Times New Roman, Serif" FontSize="14" FontWeight="Bold" 
                                Cursor="Hand" HorizontalAlignment="Left" Margin="0,0,0,5"/>
                        </StackPanel>
                    </Expander>
                </Border>

                <Border Background="#34495E" Margin="15,0,15,15" CornerRadius="3" Padding="5">
                    <Expander IsExpanded="True">
                        <Expander.Header>
                            <TextBlock Text="Quản lý" Foreground="White" FontWeight="Bold" 
                                       FontFamily="Georgia, Times New Roman, Serif" FontSize="15" Margin="5,0,0,0"/>
                        </Expander.Header>

                        <StackPanel Margin="30,15,0,5">
                            <Button Content="Nhập điểm" Command="{Binding ShowDiemCommand}"
                                Background="Transparent" BorderThickness="0" Foreground="White"
                                FontFamily="Georgia, Times New Roman, Serif" FontSize="14" FontWeight="Bold" 
                                Cursor="Hand" HorizontalAlignment="Left" Margin="0,0,0,5"/>
                        </StackPanel>
                    </Expander>
                </Border>
            </StackPanel>
        </Grid>

        <Grid Grid.Column="1" Background="#F0F3F4">
            <ContentControl Content="{Binding CurrentView}"/>
        </Grid>

    </Grid>
</Window>
