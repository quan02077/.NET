<UserControl x:Class="Buoi11.BT4.ucDiem"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Buoi11.BT4"
             xmlns:vm="clr-namespace:Buoi11.BT4"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.DataContext>
        <local:DiemVM/>
    </UserControl.DataContext>
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="Môn học:" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <ComboBox Grid.Column="1" Margin="0,0,20,0" Height="25"
                  ItemsSource="{Binding DS_MonHoc}" 
                  DisplayMemberPath="TenMonHoc" 
                  SelectedValuePath="MaMonHoc" 
                  SelectedValue="{Binding SelectedMaMon}"/>

            <TextBlock Grid.Column="2" Text="Năm học:" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <ComboBox Grid.Column="3" Margin="0,0,20,0" Height="25"
                  ItemsSource="{Binding DS_NamHoc}" 
                  SelectedItem="{Binding SelectedNamHoc}"/>

            <TextBlock Grid.Column="4" Text="Học kỳ:" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <ComboBox Grid.Column="5" Height="25"
                  ItemsSource="{Binding DS_HocKy}" 
                  SelectedItem="{Binding SelectedHocKy}"/>
        </Grid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="Tải danh sách sinh viên" Command="{Binding TaiDanhSachCmd}" Width="150" Height="30" Margin="0,0,15,0" Background="#E1E1E1"/>
            <Button Content="Lưu điểm" Command="{Binding LuuDiemCmd}" Width="100" Height="30" Background="#E1E1E1"/>
        </StackPanel>

        <DataGrid Grid.Row="2" ItemsSource="{Binding DS_KetQua}" 
              AutoGenerateColumns="False" CanUserAddRows="False" AlternatingRowBackground="#F9F9F9">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Mã SV" Binding="{Binding MaSinhVien}" IsReadOnly="True" Width="*"/>
                <DataGridTextColumn Header="Họ tên" Binding="{Binding SinhVien.HoTen}" IsReadOnly="True" Width="2*"/>
                <DataGridTextColumn Header="Lớp" Binding="{Binding SinhVien.MaLop}" IsReadOnly="True" Width="*"/>

                <DataGridTextColumn Header="Điểm" Binding="{Binding Diem}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
