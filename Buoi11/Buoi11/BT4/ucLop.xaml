<UserControl x:Class="Buoi11.BT4.ucLop"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Buoi11.BT4"
             xmlns:vm="clr-namespace:Buoi11.BT2"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.DataContext>
        <vm:LopVM/>
    </UserControl.DataContext>

    <Grid Margin="15">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Margin="0,0,15,0">
            <TextBlock Text="THÔNG TIN LỚP" FontWeight="Bold" FontSize="14" Margin="0,0,0,15" Foreground="DimGray"/>

            <TextBlock Text="Mã lớp:"/>
            <TextBox x:Name="txt_malop" Height="28" Margin="0,4,0,12" VerticalContentAlignment="Center">
                <TextBox.Text>
                    <Binding Path="NewLop.MaLop" UpdateSourceTrigger="PropertyChanged" ValidatesOnDataErrors="True"/>
                </TextBox.Text>

                <TextBox.Style>
                    <Style TargetType="TextBox">
                        <Style.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter Property="Background" Value="AliceBlue"/>
                                <Setter Property="ToolTip" Value="Mã lớp không trống"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </TextBox.Style>
            </TextBox>

            <TextBlock Text="Mã khoa:"/>
            <ComboBox ItemsSource="{Binding DS_Khoa}" 
                  DisplayMemberPath="TenKhoa" 
                  SelectedValuePath="MaKhoa" 
                  SelectedValue="{Binding NewLop.MaKhoa, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                  Height="28" Margin="0,4,0,20"/>

            <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="Thêm" Command="{Binding ThemCmd}" Width="65" Margin="5" Padding="5"/>
                <Button Content="Sửa" Command="{Binding SuaCmd}" Width="65" Margin="5" Padding="5"/>
                <Button Content="Xóa" Command="{Binding XoaCmd}" Width="65" Margin="5" Padding="5"/>
                <Button Content="Lưu" Command="{Binding LuuCmd}" Width="65" Margin="5" Padding="5"/>
                <Button Content="Hủy" Command="{Binding HuyCmd}" Width="65" Margin="5" Padding="5"/>
            </WrapPanel>
        </StackPanel>

        <Grid Grid.Column="1">
            <StackPanel>
                <TextBlock Text="DANH SÁCH LỚP" FontWeight="Bold" FontSize="14" Margin="0,0,0,15" Foreground="DimGray"/>

                <Grid>
                    <DataGrid x:Name="dgLop" 
                          ItemsSource="{Binding DS_Lop}" 
                          SelectedItem="{Binding SelectedLop}" 
                          AutoGenerateColumns="False" 
                          CanUserAddRows="False"
                          IsReadOnly="True" Height="300">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Mã lớp" Binding="{Binding MaLop}" Width="*"/>
                            <DataGridTextColumn Header="Mã khoa" Binding="{Binding MaKhoa}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Text="Chưa có dữ liệu lớp"
                           Foreground="Gray"
                           FontStyle="Italic"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ElementName=dgLop, Path=Items.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
