<Window x:Class="Buoi02.Bai2"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Buoi02"
        mc:Ignorable="d"
        Title="Bai2" Height="450" Width="800">
    <StackPanel Background="{DynamicResource BackgroundColor}" VerticalAlignment="Top">
        <TextBlock Text="Chọn Theme:" Foreground="{DynamicResource ForegroundColor}" FontSize="16"/>
        <ComboBox x:Name="cboX" HorizontalAlignment="Left" Width="150" VerticalAlignment="Top" SelectionChanged="ComboBox_ChangeTheme">
            <ComboBoxItem Content="Sáng" IsSelected="True"/>
            <ComboBoxItem Content="Tối"/>
        </ComboBox>
        <Button Content="Nút mẫu" Width="120" Height="40" Background="{DynamicResource ButtonColor}" Foreground="{DynamicResource ForegroundColor}" FontWeight="Bold" Margin="5"/>
    </StackPanel>
</Window>
