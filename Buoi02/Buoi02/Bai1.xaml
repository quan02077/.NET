<Window x:Class="Buoi02.Bai1"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Buoi02"
        mc:Ignorable="d"
        Title="Bai1" Height="450" Width="800">
    <Window.Resources>
        <Style x:Key="tbStyle" TargetType="TextBox">
            <Setter Property="Width" Value="350"/>
            <Setter Property="Height" Value="40"/>
        </Style>
        <Style x:Key="Button" TargetType="Button">
            <Setter Property="Height" Value="50"/>
            <Setter Property="Width" Value="100"/>
            <Setter Property="Margin" Value="50 10 50 50"/>
            <Setter Property="Background" Value="#abcbd1"/>
        </Style>
    </Window.Resources>
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="Thông tin" HorizontalAlignment="Center" FontSize="30" FontWeight="Bold" Margin="0,10,0,10"/>
        <Border BorderBrush="#b3dce3" Grid.Row="1" BorderThickness="3" CornerRadius="5">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#F4FAFF" Offset="0"/>
                    <GradientStop Color="#CFE6F5" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid Grid.Row="1" Margin="10">
                <StackPanel Orientation="Vertical">
                    <StackPanel Orientation="Horizontal" Margin="10">
                        <TextBlock Text="Nhập họ tên: " FontSize="18" FontWeight="Bold" Width="150"/>
                        <TextBox x:Name="txtName" Style="{StaticResource tbStyle}" LostFocus="textName"/>
                    </StackPanel>
                    <TextBlock  x:Name="lblError1" Foreground="Red" FontSize="14" Margin="150,5,0,0"/>
                    <StackPanel Orientation="Horizontal" Margin="10">
                        <TextBlock Text="Năm sinh: " FontSize="18" FontWeight="Bold" Width="150"/>
                        <TextBox x:Name="txtAge" Style="{StaticResource tbStyle}" LostFocus="textAge"/>
                    </StackPanel>
                    <TextBlock  x:Name="lblError2" Foreground="Red" FontSize="14" Margin="150,5,0,0"/>
                    <WrapPanel>
                        <Button Style="{StaticResource Button}" Content="Hiển thị" Click="btn_Show"/>
                        <Button Style="{StaticResource Button}" Content="Xóa" Click="btn_Del" />
                        <Button Style="{StaticResource Button}" Content="Thoát" Click="btn_Quit"/>
                    </WrapPanel>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
