<Window x:Class="Bai1.Bai6"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Bai1"
        mc:Ignorable="d"
        Title="Bai6" Height="450" Width="800">
    <Grid Margin="10,10,10,0" VerticalAlignment="Top">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border BorderBrush="Gray" BorderThickness="2" CornerRadius="10" Padding="3">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="35"/>
                    <RowDefinition Height="35"/>
                    <RowDefinition Height="90"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Thông tin cá nhân"
                           Grid.Row="0"
                           Grid.ColumnSpan="2"
                           FontWeight="Bold"
                           FontSize="18"
                           Margin="0,0,0,10"/>
                <TextBlock Text="Họ tên: "
                           Grid.Row="1"
                           Grid.Column="0"
                           FontSize="18"
                           FontFamily="Arial"
                           Margin="5,5,5,5"/>
                <TextBlock Text="Tuổi: "
                           Grid.Row="2"
                           Grid.Column="0"
                           FontSize="18"
                           FontFamily="Arial"
                           Margin="5,5,5,5"/>
                <TextBlock Text="Ghi chú: "
                           Grid.Row="3"
                           Grid.Column="0"
                           FontSize="18"
                           FontFamily="Arial"
                           Margin="5,5,5,5"/>
                <TextBox x:Name="txtName" Width="250" Height="29" Margin="3,3,3,3" Grid.Row="1" Grid.Column="1" LostFocus="TextBox_LostFocus"/>
                <TextBox x:Name="txtAge" Width="250" Height="29" Margin="3,3,3,3" Grid.Row="2" Grid.Column="1" LostFocus="TextBox_LostFocus"/>
                <TextBox x:Name="txtNote" Grid.Row="3" Grid.Column="1" Height="76" Grid.ColumnSpan="2" Margin="5,5,5,5" LostFocus="TextBox_LostFocus"/>
            </Grid>
        </Border>
        <Button Grid.Row="1" Content="Hiện thị thông tin" Width="300" Height="30" Margin="5" Click="Button_Click"/>
        <Border BorderBrush="Gray" BorderThickness="2" CornerRadius="10" Padding="3" Grid.Row="2">
            <TextBlock x:Name="txtShow" Grid.Row="2" TextWrapping="Wrap" FontSize="16" FontFamily="Arial" Margin="5" Height="120"/>
        </Border>
    </Grid>
</Window>
