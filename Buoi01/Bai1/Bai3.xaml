<Window x:Class="Bai1.Bai3"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Bai1"
        mc:Ignorable="d"
        Title="Bai3" Height="450" Width="800">
    <WrapPanel Orientation="Horizontal" Margin="31,55,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" ItemHeight="40" ItemWidth="360">
        <TextBlock HorizontalAlignment="Left" Margin="0,0,10,20" TextWrapping="Wrap" VerticalAlignment="Top" Text="Thông tin cá nhân" FontSize="16" FontWeight="Bold" Width="350" TextAlignment="Center"/>
        <TextBlock x:Name="show_Name" TextWrapping="Wrap" Text="Họ tên: " VerticalAlignment="Center" Width="200" FontSize="16" HorizontalAlignment="Left"/>
        <TextBox x:Name="ins_Name" TextWrapping="Wrap" Width="250" Height="20" Margin="0,0,10,10"/>
        <TextBlock x:Name="show_Age" TextWrapping="Wrap" Text="Tuổi: " FontSize="16" Width="100" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="0,0,10,10"/>
        <TextBox x:Name="ins_Age" TextWrapping="Wrap" Width="100" Margin="0,0,10,10" Height="20"/>
        <Button x:Name="btn_Submit" Content="Gửi" Width="100" Height="30" Margin="0,0,10,10" Click="btn_Submit_Click"/>

    </WrapPanel>
</Window>
