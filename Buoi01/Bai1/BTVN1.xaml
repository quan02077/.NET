<Window x:Class="Bai1.BTVN1"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Bai1"
        mc:Ignorable="d"
        Title="BTVN1" Height="600" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0"
            BorderBrush="Black"
            BorderThickness="2"
            Background="#c8cbcf">

            <StackPanel Margin="10">
                <TextBlock Text="Menu" FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>

                <Button Content="Thông tin cá nhân" Height="40" Margin="0,0,0,10"/>

                <Button Content="Cài đặt" Height="40" Margin="0,0,0,10" Click="Button_Click_cd"/>

                <Button Content="Giới thiệu" Height="40"/>
            </StackPanel>
        </Border>
        <Border Grid.Column="1" BorderBrush="Gray" BorderThickness="1" Margin="10">
            <ContentControl x:Name="CaiDat"/>
        </Border>
    </Grid>
</Window>
