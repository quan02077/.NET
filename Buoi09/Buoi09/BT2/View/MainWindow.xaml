<Window x:Class="Buoi09.BT2.View.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Buoi09.BT2.View"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Menu Grid.Row="0" Height="20" VerticalAlignment="Top" FontWeight="Bold">
            <MenuItem Header="Hệ thống">
                <MenuItem Header="Sao lưu"/>
                <MenuItem Header="Phục hồi"/>
                <Separator/>
                <MenuItem Header="Đăng xuất"/>
                <MenuItem Header="Thoát" Click="Thoat_Click"/>
            </MenuItem>

            <MenuItem Header="Danh mục"></MenuItem>
            <MenuItem Header="Quản lý điểm">
                <MenuItem Header="Nhập điểm"/>
                <MenuItem Header="Xem điểm">
                    <MenuItem Header="Theo sinh viên"/>
                    <MenuItem Header="Theo lớp" Click="XemLop"/>
                </MenuItem>
            </MenuItem>
        </Menu>
        <ContentControl x:Name="MainContent" Grid.Row="1"/>
    </Grid>
</Window>
