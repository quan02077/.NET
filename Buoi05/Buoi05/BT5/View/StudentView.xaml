<Window x:Class="Buoi05.BT5.View.StudentView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bai2" Height="590" Width="1000" Background="#ddebea">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Danh sách sinh viên"
                   HorizontalAlignment="Center"
                   FontSize="30"
                   FontWeight="Bold"/>
        <TabControl Grid.Row="1" Background="White" Margin="10" Padding="5">
            <TabItem Header="Danh sách sinh viên">
                <Grid Height="447">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Margin="10" BorderThickness="1" CornerRadius="10" BorderBrush="Gray" Padding="10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Họ và tên:" Width="100" FontWeight="Bold"/>
                                <TextBox  Width="300"/>
                                <TextBlock Text="Tuổi:" Width="100" FontWeight="Bold"/>
                                <TextBox  Width="300"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Orientation="Horizontal">
                                <TextBlock Text="Giới tính:" Width="100" Margin="0,3,0,0" FontWeight="Bold"/>
                                <RadioButton 
                                             Content="Nam"
                                             Width="150"
                                             GroupName="Gender" FontWeight="Bold"/>
                                <RadioButton 
                                             Content="Nữ"
                                             Width="150"
                                             GroupName="Gender" FontWeight="Bold"/>
                                <TextBlock Text="Thành phố:" Width="100" FontWeight="Bold"/>
                                <ComboBox  Width="300">
                                    <ComboBoxItem Content="Hà Nội"/>
                                    <ComboBoxItem Content="Đà Nẵng"/>
                                    <ComboBoxItem Content="TP.HCM"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Row="2"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        Margin="0,10,0,0">
                                <Button Content="Thêm"
                                        Margin="10"
                                        FontWeight="Bold"
                                        Height="35"
                                        Width="100"
                                        />
                                <Button Content="Sửa"
                                        Margin="10"
                                        FontWeight="Bold"
                                        Height="35"
                                        Width="100"
                                        />
                                <Button Content="Xóa"
                                    Margin="10"
                                    FontWeight="Bold"
                                    Height="35"
                                    Width="100"
                                    />
                                <Button Content="Undo"
                                    Margin="10"
                                    FontWeight="Bold"
                                    Height="35"
                                    Width="100"
                                    />
                                <Button Content="Redo"
                                    Margin="10"
                                    FontWeight="Bold"
                                    Height="35"
                                    Width="100"
                                    />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="10">
                        <TextBlock Text="Tìm theo tên" FontWeight="Bold"/>
                        <TextBox  Width="250"/>
                        <StackPanel Orientation="Horizontal" Margin="30,0,0,0">
                            <TextBlock Text="Tổng: " FontWeight="Bold" Margin="30,0,0,0"/>
                            <TextBlock/>
                            <TextBlock Text="Nam: " FontWeight="Bold" Margin="30,0,0,0"/>
                            <TextBlock/>
                            <TextBlock Text="Nữ: " FontWeight="Bold" Margin="30,0,0,0"/>
                            <TextBlock/>
                        </StackPanel>
                    </StackPanel>
                    <Border Grid.Row="3" Margin="10" BorderThickness="1" CornerRadius="10" BorderBrush="Gray" Padding="3" >
                        <ListView>
                            <ListView.View >
                                <GridView >
                                    <GridViewColumn Header = "Họ tên" Width="200"/>
                                    <GridViewColumn Header = "Tuổi" Width="100"/>
                                    <GridViewColumn Header = "Giới tính" Width="100"/>
                                    <GridViewColumn Header = "Thành phố" Width="150"/>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </Border>
                </Grid>
            </TabItem>
            <TabItem Header="Lưu / load file">
                <StackPanel HorizontalAlignment="Center">
                    <Label Content="LƯU - TẢI DỮ LIỆU SINH VIÊN"
                   FontWeight="Bold"
                   FontSize="25"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,20"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Content="Lưu file JSON"
                        Width="150"
                        Height="35"
                        Margin="10"
                        Background="#60d17e"
                        Foreground="White"
                        FontWeight="Bold"/>
                        <Button Content="Load file JSON"
                        Width="150"
                        Height="35"
                        Margin="10"
                        Background="#3498DB"
                        Foreground="White"
                        FontWeight="Bold"/>
                    </StackPanel>
                    <Label Content="Dữ liệu sinh viên sẽ được lưu và đọc từ file JSON"
                   HorizontalAlignment="Center"
                   Margin="0,20,0,0"/>
                </StackPanel>
            </TabItem>
        </TabControl>
    </Grid>
</Window>