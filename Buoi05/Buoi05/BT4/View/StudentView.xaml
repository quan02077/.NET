<Window x:Class="Buoi05.BT4.View.StudentView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Buoi05.BT4.VM"
        mc:Ignorable="d"
        Title="StudentView" Height="450" Width="900">
    <Window.DataContext>
        <local:StudentVM/>
    </Window.DataContext>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Danh sách sinh viên" HorizontalAlignment="Center" FontSize="30" FontWeight="Bold"/>
        <Border Grid.Row="1" Margin="10" BorderThickness="1" CornerRadius="10" BorderBrush="Gray" Padding="10" >
            <Grid >
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Họ và tên:" Width="100"/>
                    <TextBox Width="300" Text="{Binding NewName, Mode=TwoWay}"/>
                    <TextBlock Text="Tuổi:" Width="100"/>
                    <TextBox Width="300" Text="{Binding NewAge , Mode=TwoWay}"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Orientation="Horizontal">
                    <TextBlock Text="Giới tính:" Width="100" Margin="0,3,0,0"/>
                    <RadioButton Content="Nam" Width="150" Margin="0,3,0,0" GroupName="Gender" IsChecked="{Binding IsMale}"/>
                    <RadioButton Content="Nữ" Width="150" Margin="0,3,0,0" GroupName="Gender" IsChecked="{Binding IsFemale}"/>
                    <TextBlock Text="Thành phố:" Width="100" Margin="0,3,0,0"/>
                    <ComboBox ItemsSource="{Binding Cities}" SelectedItem="{Binding SelectedCity}" Width="300"/>
                </StackPanel>
                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                    <Button Content="Thêm" Margin="10" Background="#60d17e" Foreground="White" FontWeight="bold" Height="35" Width="100" Click="BtnAdd_Click"/>
                    <Button Content="Xóa" Margin="10" Background="#d95d4a" Foreground="White" FontWeight="bold" Height="35" Width="100" Click="BtnDel_Click"/>
                </StackPanel>
            </Grid>
        </Border>
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="10">
            <TextBlock Text="Tìm theo tên"/>
            <Border CornerRadius="5" BorderBrush="Gray" BorderThickness="1" Background="White" Padding="2">
                <TextBox BorderThickness="0" Background="Transparent" Width="250" Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"/>
            </Border>
            <StackPanel Orientation="Horizontal" Margin="30,0,0,0">
                <TextBlock Text="Tổng số sinh viên: "/>
                <TextBlock Text="{Binding StudentCount}"/>
            </StackPanel>
        </StackPanel>
        <Border Grid.Row="3" Margin="10" BorderThickness="1" CornerRadius="10" BorderBrush="Gray" Padding="3" >
            <ListView ItemsSource="{Binding StudentsView}" SelectedItem="{Binding SelectedStudent}">
                <ListView.View >
                    <GridView >
                        <GridViewColumn Header = "Họ tên" Width="200" DisplayMemberBinding="{Binding Name}"/>
                        <GridViewColumn Header = "Tuổi" Width="100" DisplayMemberBinding="{Binding Age}"/>
                        <GridViewColumn Header = "Giới tính" Width="100" DisplayMemberBinding="{Binding Gender}"/>
                        <GridViewColumn Header = "Thành phố" Width="150" DisplayMemberBinding="{Binding City}"/>
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>
    </Grid>
</Window>
